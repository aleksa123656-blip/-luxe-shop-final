# Используем легкий и надежный Linux с Node.js 18
FROM node:18-alpine

# Создаем папку внутри капсулы
WORKDIR /app

# Копируем файлы настройки
COPY package.json ./

# Устанавливаем библиотеки
RUN npm install

# Копируем весь остальной код
COPY . .

# Говорим, что будем использовать порт 3001
EXPOSE 3001

# Команда для запуска
CMD ["node", "server.js"]